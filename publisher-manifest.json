 bold}\n.spec-table {width: 100%;border-collapse: collapse;font-size: 13px;margin-top: 10px}\n.spec-table th, .spec-table td {border: 1px dashed #c2a7ad;padding: 6px 10px;text-align: left}\n.spec-table th {background: #f4eee5;color: #5c0f1e}\n\n/* 主题分组 FAQ */\n.faq-groups {display: grid;grid-template-columns: 1fr 1fr;gap: 20px}\n.faq-category {border: 2px dashed #7a1529;background: #fffdf9;padding: 20px}\n.faq-category h3 {font-size: 16px;background: #f7f0e6;padding: 6px 10px;margin-bottom: 16px;border-left: 4px solid #7a1529}\n.faq-item {margin-bottom: 16px;padding-bottom: 14px;border-bottom: 1px dotted #d9c2c6}\n.faq-item:last-child {margin-bottom: 0;padding-bottom: 0;border-bottom: none}\n.faq-item dt {font-weight: 700;font-size: 14px;color: #5c0f1e;margin-bottom: 4px}\n.faq-item dd {font-size: 13px;color: #403235}\n\n/* 页脚结算清单说明 */\n.footer-note {border-top: 2px dashed #7a1529;padding: 24px 0 12px;font-size: 13px;color: #705b5f;display: flex;flex-wrap: wrap;justify-content: space-between;gap: 12px}\n\n/* 响应式断点 */\n@media (max-width: 800px) {.hero-dashboard {\n    grid-template-columns: 1fr;}\n  .hero-cell-jumps {\n    grid-column: span 1;}\n  .plan-step-1, .plan-step-2, .plan-step-3 {\n    width: 100%;margin-left: 0;}\n  .client-board, .faq-groups {\n    grid-template-columns: 1fr;}}\n</style><main>\n  \n  <section class=\"hero-dashboard\">\n    <div class=\"hero-cell-main\">\n      <h1>jisu138 方案矩阵与接入规格表</h1>\n      <p>当前页面列出 jisu138 所有可核验服务档次、参数配额、通用客户端配置要求以及常见使用细则。请根据日常使用终端量与流量指标比对选型。</p>\n      <div>\n        RECORD ID: J138-SYS-2026 // TIER: PRD-VERIFIED\n      </div>\n    </div>\n\n    <div class=\"hero-cell-stats\">\n      <div class=\"stat-label\">基础每月额度</div>\n      <div class=\"stat-value\">100 GB</div>\n      <div class=\"stat-desc\">适用轻度访问与单一用户</div>\n    </div>\n\n    <div class=\"hero-cell-stats\">\n      <div class=\"stat-label\">旗舰专线优化</div>\n      <div class=\"stat-value\">IPLC</div>\n      <div class=\"stat-desc\">内含全节点原生流媒体支持</div>\n    </div>\n\n    <div class=\"hero-cell-stats\">\n      <div class=\"stat-label\">团队协作上限</div>\n      <div class=\"stat-value\">20 台</div>\n      <div class=\"stat-desc\">支持企业多路由与定制通道</div>\n    </div>\n\n    <div class=\"hero-cell-stats\">\n      <div class=\"stat-label\">支持服务时效</div>\n      <div class=\"stat-value\">7×24</div>\n      <div class=\"stat-desc\">高阶工单支持与专属响应</div>\n    </div>\n\n    <div class=\"hero-cell-jumps\">\n      <span>目录直达链接：</span>\n      <ul>\n        <li><a href=\"#plans\"># 阶梯方案列表</a></li>\n        <li><a href=\"#clients\"># 终端适配流程</a></li>\n        <li><a href=\"#faq\"># 常见疑难清单</a></li>\n        <li><a href=\"#summary\"># 票据存根与条款</a></li>\n      </ul>\n    </div>\n  </section>\n\n  \n  <section class=\"section-wrapper\" id=\"plans\">\n    <div class=\"section-header\">\n      <h2>01 / 阶梯订阅方案明细</h2>\n      <span class=\"section-tag\">TIER SPECIFICATION</span>\n    </div>\n\n    <div class=\"plans-ladder\">\n      \n      <article class=\"plan-step plan-step-1\">\n        <div class=\"plan-ticket-header\">\n          <div class=\"plan-title-box\">\n            <h3>基础版</h3>\n            <span>ENTRY LEVEL / 个人基础</span>\n          </div>\n          <div class=\"plan-pricing\">\n            <div class=\"plan-monthly\">¥15 <span>/ 月</span></div>\n            <span class=\"plan-annual\">按年付仅需 ¥150/年</span>\n          </div>\n        </div>\n        <ul class=\"plan-specs-grid\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n      </article>\n\n      \n      <article class=\"plan-step plan-step-2\">\n        <div class=\"plan-ticket-header\">\n          <div class=\"plan-title-box\">\n            <h3>旗舰版 <span class=\"plan-badge\">主力推荐</span></h3>\n            <span>PROFESSIONAL / 高频专线优化</span>\n          </div>\n          <div class=\"plan-pricing\">\n            <div class=\"plan-monthly\">¥35 <span>/ 月</span></div>\n            <span class=\"plan-annual\">按年付仅需 ¥350/年</span>\n          </div>\n        </div>\n        <ul class=\"plan-specs-grid\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n      </article>\n\n      \n      <article class=\"plan-step plan-step-3\">\n        <div class=\"plan-ticket-header\">\n          <div class=\"plan-title-box\">\n            <h3>团队版</h3>\n            <span>ENTERPRISE / 多人协同与定制</span>\n          </div>\n          <div class=\"plan-pricing\">\n            <div class=\"plan-monthly\">¥85 <span>/ 月</span></div>\n            <span class=\"plan-annual\">按年付仅需 ¥850/年</span>\n          </div>\n        </div>\n        <ul class=\"plan-specs-grid\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n      </article>\n    </div>\n  </section>\n\n  \n  <section class=\"section-wrapper\" id=\"clients\">\n    <div class=\"section-header\">\n      <h2>02 / 客户端接入与配置执行清单</h2>\n      <span class=\"section-tag\">CONFIGURATION PROTOCOL</span>\n    </div>\n\n    <div class=\"client-board\">\n      <div class=\"ticket-panel\">\n        <h3>跨平台导入标准化流程</h3>\n        <ul class=\"item-checklist\">\n          <li>获取专属订阅字段：在已核准账户控制台复制完整配置链接。</li>\n          <li>选择适配客户端：按本地系统要求选用支持标准代理规则的管理工具。</li>\n          <li>导入配置节点：在客户端软件中新建“从 URL 导入”，黏贴完整地址并完成初次拉取。</li>\n          <li>设定分流策略：建议切换至“按规则分流（Rule/PAC）”模式以节约月度流量计费。</li>\n          <li>节点连通性测试：发起延迟探测，确认状态无误后切换主用接入点。</li>\n        </ul>\n      </div>\n\n      <div class=\"ticket-panel\">\n        <h3>多操作系统支持基线说明</h3>\n        <table class=\"spec-table\">\n          <thead>\n            <tr>\n              <th>系统平台</th>\n              <th>推荐机制</th>\n              <th>连接特性</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <td>Windows 10/11</td>\n              <td>系统代理注入 / TUN 虚拟网卡</td>\n              <td>支持游戏路由与局域网共享</td>\n            </tr>\n            <tr>\n              <td>macOS (Intel/Apple Silicon)</td>\n              <td>增强代理路由模式</td>\n              <td>原生兼容系统托盘与自动更新</td>\n            </tr>\n            <tr>\n              <td>iOS / iPadOS</td>\n              <td>订阅链接扫码导入 / 手动配置</td>\n              <td>按需启动与自动化网络切换</td>\n            </tr>\n            <tr>\n              <td>Android</td>\n              <td>应用内自建代理规则与路由分流</td>\n              <td>可按应用排除非海外访问数据</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"section-wrapper\" id=\"faq\">\n    <div class=\"section-header\">\n      <h2>03 / 常见疑难核验（按主题分组）</h2>\n      <span class=\"section-tag\">FAQ KNOWLEDGEBASE</span>\n    </div>\n\n    <div class=\"faq-groups\">\n      \n      <div class=\"faq-category\">\n        <h3>主题 A：订阅方案与额度周期</h3>\n        <dl>\n          <div class=\"faq-item\">\n            <dt>月度流量额度是如何计算并重置的？</dt>\n            <dd>所有套餐（100GB、300GB、1000GB）均按照每个账单周期（自激活日起算满 30 天）进行结算。账单日到来时当期流量归零并自动注入下一期对应额度，未使用完毕的流量不结转至次月。</dd>\n          </div>\n          <div class=\"faq-item\">\n            <dt>基础版与旗舰版年付优惠方案是否可以随时升级？</dt>\n            <dd>支持在账单中心进行平滑升级。升级时系统将根据旧方案剩余有效天数折算差价，支付差额后立即应用旗舰版的 300GB 配额及 IPLC 专线池权限。</dd>\n          </div>\n        </dl>\n      </div>\n\n      \n      <div class=\"faq-category\">\n        <h3>主题 B：网络调度与连接排查</h3>\n        <dl>\n          <div class=\"faq-item\">\n            <dt>遇到订阅链接拉取失败或更新超时应如何排查？</dt>\n            <dd>第一步请确认本地网络环境能够访问普通网页；第二步检查客户端系统时间是否与标准北京时间同步误差在 60 秒以内；第三步可尝试更换订阅前置域名或关闭本地安全拦截软件的规则过滤。</dd>\n          </div>\n          <div class=\"faq-item\">\n            <dt>全节点原生流媒体解锁是如何运作的？</dt>\n            <dd>旗舰版与团队版节点池部署有原生流媒体调度策略，会自动识别请求并指向合规出口。若遇到特定内容平台提示区域受限，建议在客户端内切换至同区域的备用节点并清除浏览器缓存重试。</dd>\n          </div>\n        </dl>\n      </div>\n\n      \n      <div class=\"faq-category\">\n        <h3>主题 C：设备管理与团队协同</h3>\n        <dl>\n          <div class=\"faq-item\">\n            <dt>同时在线设备数量限制是如何判定的？</dt>\n            <dd>jisu138 系统以活跃心跳连接与实时 IP 通讯线程为准。基础版限制 3 台、旗舰版 5 台、团队版 20 台同时处于数据传输状态。若超出上限，后接入设备将收到网络等待提示。</dd>\n          </div>\n          <div class=\"faq-item\">\n            <dt>团队版的“企业定制路由”指代什么功能？</dt>\n            <dd>团队版支持通过专属控制台分配内部子账号，且可针对不同网络分支配置专用的分流清单（例如锁定指定业务网段直连或专线代理），并享有专属客户经理的技术对接。</dd>\n          </div>\n        </dl>\n      </div>\n\n      \n      <div class=\"faq-category\">\n        <h3>主题 D：技术服务与支持通道</h3>\n        <dl>\n          <div class=\"faq-item\">\n            <dt>旗舰版的 7x24 优先工单响应时限是多少？</dt>\n            <dd>旗舰版用户提交的工单将进入高优先级响应队列，通常在提交后 30 分钟内由当值技术专员进行日志分析并给予排查指引。</dd>\n          </div>\n          <div class=\"faq-item\">\n            <dt>若需变更已绑定的主要邮箱或转移配置，步骤如何？</dt>\n            <dd>请登入个人中心提交安全验证申请。通过安全代码验证后，方可在后台直接重置订阅密钥以作废原有设备的接入权限。</dd>\n          </div>\n        </dl>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"footer-note\" id=\"summary\">\n    <div>\n      <strong>jisu138 运维系统存根</strong> ｜ 严格按方案配额执行流量与并发控制\n    </div>\n    <div>\n      <a href=\"#\">返回页面顶部</a> ｜ <a href=\"#plans\">核验订阅参数</a> ｜ <a href=\"#clients\">查看配置指引</a>\n    </div>\n  </footer>\n</main>",
